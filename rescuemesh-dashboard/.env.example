# RescueMesh server base URL for the dashboard.
# Default (when unset): http://localhost:8081
# On the user's LAN, set this to the server machine's LAN IP, e.g.
# VITE_API_BASE=http://192.168.1.20:8081
# After deployment: the fixed Render URL.
VITE_API_BASE=http://localhost:8081

# RescueMesh ML service base URL (priority scoring, duplicate flags,
# face-match assist). Optional and advisory only — when it is unset or
# the service is unreachable, the dashboard simply keeps its honest
# "ML score: not connected yet" labels and shows no ML badges.
# Default (when unset): http://localhost:8001
VITE_ML_BASE=http://localhost:8001
