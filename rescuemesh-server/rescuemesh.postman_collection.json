{
  "info": {
    "name": "RescueMesh Server",
    "description": "RescueMesh sync backend - auth v2, roles, and Prompt 7 sync API. Set baseUrl; run Login (or Verify email) and paste the returned token into the token variable; use adminToken for the /admin requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth v2",
      "item": [
        {
          "name": "Register (always CITIZEN, sends verification code)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"apoorv\",\n  \"email\": \"apoorv@example.org\",\n  \"password\": \"secret123\",\n  \"deviceId\": \"56475aa75463474c0285df5dbf2bcab73da651358839e9b77481b2eab107708c\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify email (returns a token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "description": "The 6-digit code arrives by email (Resend) or in the server log in dev mode.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"apoorv\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Resend verification code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend-verification"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"apoorv\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login (verified emails only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"apoorv\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Device token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/device",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "device"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"56475aa75463474c0285df5dbf2bcab73da651358839e9b77481b2eab107708c\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Apply for a role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/roles/apply",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "roles",
                "apply"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestedRole\": \"VOLUNTEER\",\n  \"organization\": \"Campus rescue club\",\n  \"reason\": \"Volunteering for the demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "My applications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/roles/my-applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "roles",
                "my-applications"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Admin: list role applications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/role-applications?status=PENDING",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "role-applications"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Admin: approve application (returns the one-time code once)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/role-applications/1/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "role-applications",
                "1",
                "approve"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Admin: reject application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/role-applications/1/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "role-applications",
                "1",
                "reject"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Not enough detail\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Admin: direct role code (any role, incl. ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/role-codes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "role-codes"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"apoorv\",\n  \"role\": \"COORDINATOR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Redeem role access code (returns a fresh token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/role-code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "profile",
                "role-code"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"RM-XXXXX-XXXXX\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Bind device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/bind-device",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "profile",
                "bind-device"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"56475aa75463474c0285df5dbf2bcab73da651358839e9b77481b2eab107708c\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Sync",
      "item": [
        {
          "name": "Server sync public key (PUBLIC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sync/pubkey",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sync",
                "pubkey"
              ]
            },
            "description": "Returns {keyId, publicKey} - phones verify serverAck signatures with this key.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Sync batch (sample = the fixed test vector)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sync/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sync",
                "batch"
              ]
            },
            "description": "NOTE: the sample is the fixed cross-side test vector (created Nov 2023); against a live server clock it is REJECTED as expired - that is the correct behaviour. Replace the envelope with a fresh, currently-valid signed envelope for a live ACCEPTED demo.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"56475aa75463474c0285df5dbf2bcab73da651358839e9b77481b2eab107708c\",\n  \"items\": [\n    {\n      \"envelope\": {\n        \"messageId\": \"12345678-1234-4234-9234-1234567890ab\",\n        \"eventType\": \"SOS\",\n        \"originDeviceId\": \"56475aa75463474c0285df5dbf2bcab73da651358839e9b77481b2eab107708c\",\n        \"createdAt\": 1700000000000,\n        \"expiresAt\": 1700086400000,\n        \"priority\": 1,\n        \"hopLimit\": 8,\n        \"hopCount\": 0,\n        \"hopTrace\": [\n          {\n            \"i\": 0,\n            \"role\": \"ORIGIN\",\n            \"deviceId\": \"56475aa75463474c0285df5dbf2bcab73da651358839e9b77481b2eab107708c\",\n            \"pk\": \"A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg\",\n            \"at\": 1700000000000,\n            \"prevSig\": \"\",\n            \"sig\": \"que4YgpLPBO7pSi8H1_0qgeH5jx_G0FzKo6_l_DkYutQ03MvV39k7rAJtSO8zrSed7Vud2Q45mLIQcuWkxHeDg\"\n          }\n        ],\n        \"payload\": {\n          \"category\": \"MEDICAL\",\n          \"description\": \"Trapped under debris\",\n          \"peopleCount\": 3,\n          \"injured\": 1\n        },\n        \"signature\": \"7BfTxpgGrAvUhFV7OGbpM_-ITV15MWjUAy3Hed6QraGldYNRk2YDWBlv1JkPc_hr3_c0IfQG1uSfmjUUPThrBQ\"\n      },\n      \"originPublicKey\": \"A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Records: SOS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/records/sos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "records",
                "sos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Records: missing persons",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/records/missing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "records",
                "missing"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Records: announcements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/records/announcements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "records",
                "announcements"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Records: messages (envelope-shaped)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/records/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "records",
                "messages"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Upload photo (raw JPEG, verified against photoRef)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/jpeg"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sync/photo?messageId=REPLACE_WITH_MESSAGE_ID",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sync",
                "photo"
              ],
              "query": [
                {
                  "key": "messageId",
                  "value": "REPLACE_WITH_MESSAGE_ID"
                }
              ]
            },
            "description": "Photo gateway upload (photo transfer design section 3). First sync the envelope via Sync batch - its payload photoRef must name this messageId. Then set Body -> file and pick the exact JPEG: the server checks size + SHA-256 against the signed photoRef (mismatch -> 400, nothing stored; unknown messageId -> 404). Re-uploading the same photo returns 200 ALREADY_EXISTS.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            }
          }
        },
        {
          "name": "Get photo (stored JPEG for a record)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/records/photos/REPLACE_WITH_MESSAGE_ID",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "records",
                "photos",
                "REPLACE_WITH_MESSAGE_ID"
              ]
            },
            "description": "Streams the verified photo stored on the server for the given record messageId (200 image/jpeg, or 404 when no photo was uploaded). Use the Missing record's messageId for its photo and the case view's foundMessageId (/records/missing) for the Found record's photo - that pair is the dashboard's side-by-side case view.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
