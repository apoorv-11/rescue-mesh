# Copy to .env and adjust. Every value has a local-dev default in
# docker-compose.yml / application.yml, so an empty .env still runs locally.

# PostgreSQL
POSTGRES_DB=rescuemesh
POSTGRES_USER=rescuemesh
POSTGRES_PASSWORD=rescuemesh
DB_PORT=5432

# App
APP_PORT=8080
# JWT signing secret (HS256) — MUST be >= 32 characters, MUST be changed
# outside local development.
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
# Seeded admin (created on first boot if absent)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Mail (auth v2) via Resend (HTTPS API) — OPTIONAL. Leave RESEND_API_KEY
# blank for dev mode: no real email is sent and verification / role access
# codes are written to the server log instead.
# Get a key at resend.com → API Keys. Note the sandbox restriction: with the
# default sender onboarding@resend.dev, Resend can only email YOUR OWN
# account address — to email testers/other users you must verify a domain in
# Resend (Domains → add domain → add the DKIM/SPF DNS records) and set
# RESEND_FROM to an address on that domain.
RESEND_API_KEY=
RESEND_FROM=RescueMesh <onboarding@resend.dev>

# Sync ack signing key (Prompt 7) — OPTIONAL for local dev. Standard Base64
# of a PKCS#8 DER Ed25519 private key. Leave blank for dev mode: an ephemeral
# key is generated at startup (WARN in the log) and server acks will NOT
# verify across restarts. Set it for any real deployment — see the README
# "Server sync (Prompt 7)" section for the openssl commands to generate one.
SYNC_SIGNING_KEY=
